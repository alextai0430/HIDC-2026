# Template only: use a separate Supabase development project and replace these locally.
# Browser-safe development project URL and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEV_PUBLISHABLE_OR_ANON_KEY
# Server only. Never prefix this with NEXT_PUBLIC or share it with judges.
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY
# Keep false for connected development. The synthetic demo mode is not for real data.
NEXT_PUBLIC_BYPASS_AUTH=false
# Server-only shared password required to reveal the Admin tab's score values.
ADMIN_VIEW_PASSWORD=replace-with-the-admin-view-password
