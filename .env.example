# Browser-safe Supabase project URL and publishable/anon key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server only. Never prefix these with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Legacy admin-password settings: unused by the current account-based permission model.
# Retained only for a possible future password feature. Never expose server secrets to the browser.
SCORING_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
ADMIN_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Legacy flag: currently ignored. Administrator access always follows the account's
# is_admin flag or server_admin role. Score Details and personal Admin need no password.
NEXT_PUBLIC_ADMIN_PROTECTION_ENABLED=false
# Local isolated demo only. MUST be false for a real event.
NEXT_PUBLIC_BYPASS_AUTH=false
